ZEEKR_EMAIL=your@email.com
ZEEKR_PASSWORD=yourpassword
ZEEKR_COUNTRY_CODE=AU

# --- Notifications (position monitor) ---
# Home base + per-event toggles are PER-USER preferences (users.json), edited in
# the dashboard. .env holds only deployment/transport config:
NOTIFY_ENABLED=true            # global kill switch
NOTIFY_SERVICE=signal
NOTIFY_USER_EMAIL=your@email.com   # whose home base/toggles drive the Signal channel
POLL_INTERVAL=60               # seconds between position checks (min 30)

# Tuning constants
HOME_HYSTERESIS_KM=0.2         # buffer so a car parked near the radius doesn't flap
MOVE_THRESHOLD_M=100           # min displacement (m) to count as moved (GPS jitter guard)

# signal-cli-rest-api backend
SIGNAL_API_URL=http://localhost:8080
SIGNAL_FROM=+614xxxxxxxx       # registered sender number
SIGNAL_TO=+614yyyyyyyy         # recipient(s), comma-separated for multiple
SIGNAL_USER=                   # optional HTTP basic-auth user (if daemon behind proxy)
SIGNAL_PASS=                   # optional HTTP basic-auth password
